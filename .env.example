# =====================================================================
# AGENTOFFICE — ENTORNO DE CONFIGURACIÓN DE EJEMPLO (.env.example)
# =====================================================================
# Todas las claves deben suministrarse con valores reales en .env local.
# NUNCA incluyas credenciales reales en este archivo ni en el repositorio.

# ---------------------------------------------------------------------
# 1. PROVEEDORES DE MODELOS LLM (PRIMARIO Y MULTI-MODELO FALLBACKS)
# ---------------------------------------------------------------------
# API Key principal para Google Gemini (Google AI Studio)
GEMINI_API_KEY=dummy-key-for-tests

# Claves opcionales para enrutamiento dinámico, diagnóstico y fallback chains
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Modo Mock 100% offline (ejecuta el grafo completo sin consumir tokens de APIs)
USE_MOCK_LLM=false

# Modelo por defecto del catálogo (ej. gemini-2.5-flash o gemini-3.5-flash)
DEFAULT_LLM_MODEL=gemini-3.5-flash

# Costos unitarios estimados por millón de tokens (USD)
LLM_INPUT_COST_PER_MILLION=0.35
LLM_OUTPUT_COST_PER_MILLION=1.05

# Sobrescrituras de modelo por agente (formato JSON: {"agente_01_pm": "gemini-3.5-pro"})
AGENT_MODEL_OVERRIDES={}

# Retardo en segundos entre agentes para prevenir Rate Limiting (HTTP 429)
RATE_LIMIT_DELAY_SECONDS=4.0

# Máximo número de reintentos por compuerta de calidad (Circuit Breaker Anti-Loop)
MAX_RETRIES_PER_GATE=3

# ---------------------------------------------------------------------
# 2. PERSISTENCIA, BASES DE DATOS Y DIRECTORIOS DE TRABAJO
# ---------------------------------------------------------------------
CHECKPOINT_DB_PATH=workspaces/checkpoints.sqlite
OFFICE_DB_PATH=workspaces/office_data.sqlite
WORKSPACES_DIR=workspaces
PROMPTS_DIR=prompts

# ---------------------------------------------------------------------
# 3. NOTION WORKSPACE & MCP DOCUMENTATION SYNC
# ---------------------------------------------------------------------
# Clave de integración interna de Notion (Token 'secret_...')
NOTION_API_KEY=
# ID de la página raíz donde se publican los manuales y entregables
NOTION_PARENT_PAGE_ID=
# ID opcional de la base de datos ejecutiva del CEO
NOTION_CEO_DATABASE_ID=
# Activa el conector de sincronización Notion MCP
NOTION_MCP_ENABLED=false

# ---------------------------------------------------------------------
# 4. COMUNICACIONES Y ALERTAS (RESEND & EMAIL SMTP/IMAP)
# ---------------------------------------------------------------------
RESEND_API_KEY=
FOUNDER_ALERT_EMAIL=
TAVILY_API_KEY=

# Servidor de correo real para notificaciones y alertas
REAL_MAIL_ENABLED=false
SMTP_HOST=smtp.strato.com
SMTP_PORT=465
IMAP_HOST=imap.strato.com
IMAP_PORT=993
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------------------------------------------------------------------
# 5. AUTOMATIZACIÓN DE MARKETING CON N8N
# ---------------------------------------------------------------------
# Topología de Red Dual:
# - N8N_BASE_URL: URL para comunicación interna backend FastAPI -> n8n.
#   En local: "http://localhost:5678" | En Docker bridge: "http://n8n:5678"
N8N_BASE_URL=http://localhost:5678
# API Key de n8n para aprovisionamiento REST (/api/v1/workflows)
N8N_API_KEY=
# - N8N_WEBHOOK_URL: URL pública o de host para webhooks de n8n accesibles por el navegador
#   o servicios externos (ej. Webhook Ingesta Marketing). Resuelve a "http://localhost:5678"
#   incluso cuando FastAPI opera en Docker ("http://n8n:5678")
N8N_WEBHOOK_URL=http://localhost:5678

# ---------------------------------------------------------------------
# 6. DESPLIEGUES Y CONTROL DE VERSIONES (GITHUB & VERCEL)
# ---------------------------------------------------------------------
GITHUB_TOKEN=
GITHUB_USERNAME=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---------------------------------------------------------------------
# 7. TELEMETRÍA Y OBSERVABILIDAD (LANGSMITH)
# ---------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://eu.api.smith.langchain.com"
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="agentoffice"

# ---------------------------------------------------------------------
# 8. CENTRO DE CONTROL DE WHATSAPP BUSINESS API
# ---------------------------------------------------------------------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=agentoffice_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_ALLOWED_PHONES=[]
