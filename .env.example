# API Key for Google Gemini (Google AI Studio)
GEMINI_API_KEY=dummy-key-for-tests

# Set to true to run the full graph without consuming API tokens
USE_MOCK_LLM=false

# Default model (compatible with Gemini 2.5 Flash free tier)
DEFAULT_LLM_MODEL=gemini-2.5-flash

# Model overrides per agent (JSON string: {"agente_01_pm": "gemini-1.5-pro"})
AGENT_MODEL_OVERRIDES={}

# Rate limiting delay in seconds between agents
RATE_LIMIT_DELAY_SECONDS=4.0

# Circuit breaker max retries for QA and CISO gates
MAX_RETRIES_PER_GATE=3

# Workspace and storage paths
CHECKPOINT_DB_PATH=workspaces/checkpoints.sqlite
WORKSPACES_DIR=workspaces
PROMPTS_DIR=prompts

# Telemetry and Observability (LangSmith)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="agentoffice"

# --- AGENTE 00 CEO: INTEGRACIONES GRATUITAS (OPCIONALES) ---
NOTION_API_KEY=
NOTION_CEO_DATABASE_ID=
RESEND_API_KEY=
FOUNDER_ALERT_EMAIL=
TAVILY_API_KEY=


# --- WhatsApp Business API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=agentoffice_verify_2026
WHATSAPP_APP_SECRET=
WHATSAPP_ENABLED=false
